<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updates from GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Uninstalling Piume, once its settings and history are here (Android asks first; see FromPiume). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Lets us read every app's Watch Next entries (same permission Projectivy uses). -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Dictating a title into the search box (asked for the first time someone picks Say it). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <!-- Folder wallpapers: asked for only when someone picks "Choose a folder on this TV". -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Granted once over adb (pm grant link.mccoy88f.zephyr android.permission.WRITE_SECURE_SETTINGS) so the app can
         re-enable its Home service: Android drops it from the enabled list whenever the app is force-stopped. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Piume, what Zephyr TV was: its settings and history are taken on the first start (see FromPiume). -->
        <package android:name="dev.piume" />
        <!-- Sony TVs: which external inputs have a device connected (see connectedInputs). -->
        <provider android:authorities="com.sony.dtv.tvinput.external.provider" />
    </queries>

    <!-- Cleartext stays allowed: Continue Watching posters come from other apps' listings, and some give
         plain http addresses. Everything Zephyr TV asks for itself (TMDB, weather, updates) is https. -->
    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The player for the Stremio add-ons' channels, in a process of its own: a stream that hangs or a decoder
             that crashes can't take the home screen with it. -->
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:process=":player"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- The update installer reports here; not exported, so only Android (via Zephyr TV's PendingIntent) can. -->
        <receiver android:name=".InstallResult" android:exported="false" />

        <!-- Back to the home screen after an update (Android kills the old version, which uncovers the last app). -->
        <receiver android:name=".Updated" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Gallery screensaver; switched on and off from launcher settings. -->
        <service
            android:name=".GalleryDream"
            android:exported="true"
            android:label="@string/gallery"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Google TV's launcher must stay enabled; this service replaces it on screen whenever it shows. -->
        <service
            android:name=".HomeOverride"
            android:exported="false"
            android:label="@string/home_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_override" />
        </service>
        <!-- Lets Zephyr TV see what's playing (media sessions) for the Play queue; it reads no notifications. -->
        <service
            android:name=".PlayingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
